<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force index.html for root directory
  DirectoryIndex index.html index.htm

  # Handle static HTML files without extension
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # Handle dynamic news article page: /news/slug/ -> /news/index.html with slug param or client router
  RewriteRule ^news/([^/]+)/?$ /news/index.html [L]

  # Trailing slash fallback
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)/$ $1/index.html [L]

  # 404 fallback
  ErrorDocument 404 /404.html
</IfModule>
